{
  "name": "latexdesk",
  "productName": "LaTeXDesk",
  "version": "0.8.0",
  "description": "Desktop LaTeX editor built on Overleaf's open-source editor components",
  "license": "AGPL-3.0-only",
  "author": "RJUNCC",
  "homepage": "https://github.com/RJUNCC/LaTeXDesk",
  "repository": {
    "type": "git",
    "url": "https://github.com/RJUNCC/LaTeXDesk.git"
  },
  "bugs": {
    "url": "https://github.com/RJUNCC/LaTeXDesk/issues"
  },
  "main": "main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs --minify && electron-builder --win"
  },
  "build": {
    "appId": "local.texdesk",
    "productName": "LaTeXDesk",
    "files": [
      "main.js",
      "ai.js",
      "research.js",
      "export.js",
      "zotero.js",
      "languagetool.js",
      "preload.js",
      "dist/**/*",
      "!dist/*.map",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "LaTeXDesk Setup ${version}.${ext}"
    },
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.4",
    "@lezer/generator": "^1.8.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.11",
    "dictionary-en": "^4.0.0",
    "diff": "^9.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "katex": "^0.19.1",
    "mammoth": "^1.13.0",
    "marked": "^16.4.2",
    "mathjs": "^14.9.1",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "fflate": "^0.8.3"
  }
}
